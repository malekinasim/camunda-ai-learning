<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                   id="Definitions_1"
                   targetNamespace="http://camunda.org/schema/1.0/bpmn">

  <bpmn:process id="resume-review-process" name="Resume Review Process" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="New job posting found">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- This is the key element: a Service Task with a Zeebe "task type".
         Zeebe doesn't run any code itself here - it just creates a job of
         type "call-ai-agent" and waits. Our Java Job Worker (see
         AiAgentWorker.java) subscribes to that exact type name and does
         the actual work: calling the Claude API. -->
    <bpmn:serviceTask id="Task_CallAiAgent" name="Evaluate resume match with AI">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="call-ai-agent" />
        <!-- ioMapping declares which process variables go IN to the job
             (visible to the worker) and which come OUT (written back to
             the process after the worker completes the job). -->
        <zeebe:ioMapping>
          <zeebe:input source="= resumeText" target="resumeText" />
          <zeebe:input source="= jobDescription" target="jobDescription" />
          <zeebe:output source="= matchScore" target="matchScore" />
          <zeebe:output source="= verdict" target="verdict" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A simple gateway: if the AI's match score is decent, go straight
         to a human review task; otherwise skip straight to the end.
         This is the "human task stays" part of your idea. -->
    <bpmn:exclusiveGateway id="Gateway_1" name="Worth a human look?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHuman</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_HumanReview" name="Human: review AI's suggested tailored resume">
      <bpmn:incoming>Flow_ToHuman</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Reviewed" name="Reviewed by human">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Skipped" name="Skipped - low match">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CallAiAgent" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CallAiAgent" targetRef="Gateway_1" />

    <bpmn:sequenceFlow id="Flow_ToHuman" sourceRef="Gateway_1" targetRef="Task_HumanReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        = matchScore &gt;= 50
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Gateway_1" targetRef="EndEvent_Skipped">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        = matchScore &lt; 50
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_HumanReview" targetRef="EndEvent_Reviewed" />

  </bpmn:process>

  <!-- Visual layout only - lets Camunda Modeler open and display this diagram.
       Has no effect on execution. Feel free to drag things around in the
       Modeler; it will rewrite this section for you automatically. -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="resume-review-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CallAiAgent_di" bpmnElement="Task_CallAiAgent">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HumanReview_di" bpmnElement="Task_HumanReview">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reviewed_di" bpmnElement="EndEvent_Reviewed">
        <dc:Bounds x="652" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Skipped_di" bpmnElement="EndEvent_Skipped">
        <dc:Bounds x="412" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="240" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="395" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHuman_di" bpmnElement="Flow_ToHuman">
        <di:waypoint x="445" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="500" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="420" y="145" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="420" y="220" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="600" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
        <di:waypoint x="652" y="120" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
